<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" id="metaThemeColor" content="#FAFAFA">
  <title>{{ article.title }} // {{ profile.name }}</title>
  <meta name="description" content="{{ article.excerpt }}">
  <meta name="author" content="{{ profile.name }}">

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <!-- Canonical -->
  <link rel="canonical" href="{{ profile.url }}/articles/{{ article.slug }}/">

  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ article.title }}">
  <meta property="og:description" content="{{ article.excerpt }}">
  <meta property="og:url" content="{{ profile.url }}/articles/{{ article.slug }}/">
  <meta property="og:site_name" content="{{ profile.name }}">
  {% if profile.og_image %}<meta property="og:image" content="{{ profile.og_image }}">{% endif %}

  <!-- Feeds -->
  {% for feed in feeds %}<link rel="alternate" type="{{ feed.mime }}" title="{{ feed.title }}" href="{{ feed.file }}">
  {% endfor %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&family=Playfair+Display:wght@400;700&family=DM+Sans:wght@400;700&family=Fraunces:opsz,wght,9..144,400;9..144,700&family=Outfit:wght@400;700&family=Anton&family=Bebas+Neue&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/sanko.css?v=13">

  {% if analytics.plausible.enabled %}<!-- Plausible analytics -->
  <script defer data-domain="{{ analytics.plausible.domain }}" src="{{ analytics.plausible.src }}"></script>
  {% endif %}
  {% if analytics.cloudflare.enabled %}<!-- Cloudflare analytics -->
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "{{ analytics.cloudflare.token }}"}'></script>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "{{ article.title }}",
    "author": {
      "@type": "Person",
      "name": "{{ profile.name }}",
      "url": "{{ profile.url }}"
    },
    "datePublished": "{{ article.date | date: "%Y-%m-%dT%H:%M:%S%z" }}",
    "dateModified": "{{ article.date | date: "%Y-%m-%dT%H:%M:%S%z" }}",
    "publisher": {
      "@type": "Organization",
      "name": "{{ profile.name }}"
    }
  }
  </script>

  <script>
    (function() {
      var saved = localStorage.getItem('swiss-color');
      var paramColor = new URLSearchParams(window.location.search).get('color') || '';
      if (paramColor) {
        var hex = paramColor.replace(/^#/, '');
        if (/^[0-9a-fA-F]{3}$/.test(hex)) {
          hex = hex.charAt(0) + hex.charAt(0) + hex.charAt(1) + hex.charAt(1) + hex.charAt(2) + hex.charAt(2);
        }
        if (/^[0-9a-fA-F]{6}$/.test(hex)) {
          saved = '#' + hex.toLowerCase();
          try { localStorage.setItem('swiss-color', saved); } catch (e) {}
        }
      }
      var doc = document.documentElement;
      var m = document.getElementById('metaThemeColor');
      if (saved) {
        doc.style.setProperty('--primary', saved);
        doc.style.backgroundColor = saved;
        if (m) m.setAttribute('content', saved);
      } else {
        var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (m) m.setAttribute('content', dark ? '#111111' : '#FAFAFA');
      }
      var f = localStorage.getItem('swiss-font');
      var paramFont = new URLSearchParams(window.location.search).get('font') || '';
      if (paramFont) {
        var fontName = paramFont.trim().replace(/['"]/g, '');
        var serifFonts = ['IBM Plex Serif','Playfair Display','Fraunces','Cardo','Cormorant Garamond','EB Garamond','Spectral','Source Serif 4','Literata','Newsreader','Hepta Slab','Domine','Zilla Slab','DM Serif Display'];
        var fontGeneric = serifFonts.indexOf(fontName) !== -1 ? 'serif' : (fontName === 'IBM Plex Mono' ? 'monospace' : 'sans-serif');
        f = (fontName.indexOf(' ') !== -1 ? "'" + fontName + "'" : fontName) + ', ' + fontGeneric;
        try { localStorage.setItem('swiss-font', f); } catch (e) {}
      }
      if (f) {
        document.documentElement.style.setProperty('--font', f);
        var fontName = f.split(',')[0].replace(/['"]/g, '').trim();
        var l = document.createElement('link');
        l.rel = 'stylesheet';
        l.href = 'https://fonts.googleapis.com/css2?family=' + fontName.replace(/ /g,'+') + ':wght@400;700;900&display=swap';
        document.head.appendChild(l);
      }
    })();
  </script>
</head>
<body class="swiss-page tufte-body">

  <div class="reading-progress" aria-hidden="true"></div>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <nav class="swiss-nav">
    <a href="/" class="nav-mark" aria-label="Home">SR</a>
    <div class="nav-actions">
      <button type="button" class="nav-settings" id="settingsToggle" aria-expanded="false" aria-controls="settingsPanel" aria-label="Toggle display settings" title="Change the theme and font">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>
      <button type="button" class="nav-settings" id="shareLinkBtn" aria-label="Copy a link to this page with the current color, font, and filters. Tap to copy, press and hold for options." title="Tap to copy a link to this page; press and hold for options">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </button>
      {% if feeds %}
      <a class="nav-settings" href="/feed.xml" type="application/rss+xml" aria-label="Subscribe to the RSS feed" title="RSS feed">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
      </a>
      {% endif %}
    </div>
  </nav>

  <div class="settings-panel" id="settingsPanel" hidden>
    <div class="settings-group">
      <label class="settings-label" for="fontSelect">Typeface</label>
      <select class="settings-select" id="fontSelect"></select>
    </div>
    <div class="settings-group">
      <label class="settings-label">Theme Color</label>
      <div class="color-presets" role="group" aria-label="Color presets">
        <button type="button" class="preset-btn" data-color="#DA291C" style="--swatch: #DA291C" aria-label="Swiss Red"></button>
        <button type="button" class="preset-btn" data-color="#D4FF00" style="--swatch: #D4FF00" aria-label="Chartreuse"></button>
        <button type="button" class="preset-btn" data-color="#FF1493" style="--swatch: #FF1493" aria-label="Deep Pink"></button>
        <button type="button" class="preset-btn" data-color="#0055FF" style="--swatch: #0055FF" aria-label="Cobalt Blue"></button>
        <button type="button" class="preset-btn" data-color="#FF5E00" style="--swatch: #FF5E00" aria-label="Safety Orange"></button>
        <button type="button" class="preset-btn" data-color="#8A2BE2" style="--swatch: #8A2BE2" aria-label="Electric Purple"></button>
        <button type="button" class="preset-btn" data-color="#00E5FF" style="--swatch: #00E5FF" aria-label="Cyan"></button>
        <button type="button" class="preset-btn" data-color="#111111" style="--swatch: #111111" aria-label="Pitch Black"></button>
        <div class="color-presets-muted">
            <button type="button" class="preset-btn" data-color="#6a5c5c" style="--swatch: #6a5c5c" aria-label="Muted Taupe"></button>
            <button type="button" class="preset-btn" data-color="#5c646c" style="--swatch: #5c646c" aria-label="Muted Slate"></button>
            <button type="button" class="preset-btn" data-color="#5d6b5c" style="--swatch: #5d6b5c" aria-label="Muted Sage"></button>
            <button type="button" class="preset-btn" data-color="#6d5c6c" style="--swatch: #6d5c6c" aria-label="Muted Mauve"></button>
            <button type="button" class="preset-btn" data-color="#7a6a5c" style="--swatch: #7a6a5c" aria-label="Muted Tan"></button>
            <button type="button" class="preset-btn" data-color="#5c5c66" style="--swatch: #5c5c66" aria-label="Muted Graphite"></button>
        </div>
      </div>
      <div class="color-row">
        <label for="colorPicker" class="sr-only" style="display:none;">Custom color picker</label>
        <input type="color" class="settings-color" id="colorPicker" value="#fafafa">
        <span class="color-hex" id="colorHex" aria-hidden="true">#FAFAFA</span>
      </div>
    </div>
    <div class="settings-group settings-close-row">
      <small class="settings-hint">Click <kbd>ESC</kbd> or tap outside to close</small>
    </div>
  </div>

  <div class="share-panel" id="sharePanel" hidden>
    <span class="share-title">Share this page</span>
    <label class="share-opt"><input type="checkbox" id="shareColor" checked> Include current color</label>
    <label class="share-opt"><input type="checkbox" id="shareFont" checked> Include current font</label>
    <label class="share-opt"><input type="checkbox" id="shareScroll"> Include scroll position</label>
    <label class="share-opt" id="shareFiltersRow"><input type="checkbox" id="shareFilters" checked> Include filters &amp; view</label>
    <input type="text" class="share-url" id="shareUrl" readonly aria-label="Shareable link">
    <button type="button" class="share-copy" id="shareCopyBtn">Copy link</button>
  </div>

  <main id="main-content">
    <header class="post-header">
      <h1 class="post-title">{{ article.title }}</h1>
      <div class="post-meta">
        <div class="post-meta-row post-meta-row-main">
          <span class="post-date"><time datetime="{{ article.date | date: "%Y-%m-%d" }}">{{ article.date | date: "%B %d, %Y" }}</time></span>
          {% if article.readTime %}<span class="post-readtime">{{ article.readTime }} Min Read</span>{% endif %}
        </div>
        <div class="post-meta-row post-meta-row-aux">
          {% if article.repo %}<span class="post-repo"><a href="/?tags={{ article.repoTag }}&amp;view=articles">#{{ article.repoDisplay }}</a></span>{% endif %}
          {% if article.url %}<span class="post-discuss"><a href="{{ article.url }}" target="_blank" rel="noopener noreferrer">Discuss on GitHub ↗</a></span>{% endif %}
        </div>
      </div>
    </header>

    <article class="post-content">
      {{ article.body | markdown }}
    </article>

    {% if article.showComments %}
    <section class="comments" id="comments">
      <h2>Comments</h2>
      <script src="https://giscus.app/client.js"
        data-repo="{{ article.owner }}/{{ article.repo }}"
        data-repo-id="{{ article.repoId }}"
        data-category="{{ article.category }}"
        data-category-id="{{ article.categoryId }}"
        data-mapping="number"
        data-strict="0"
        data-reactions-enabled="{% if giscus.reactionsEnabled %}1{% else %}0{% endif %}"
        data-emit-metadata="1"
        data-input-position="bottom"
        data-term="{{ article.discussionNumber }}"
        data-theme="{{ giscus.theme | default: 'preferred_color_scheme' }}"
        {% if giscus.lazyLoading %}data-loading="lazy"{% endif %}
        data-lang="en"
        crossorigin="anonymous"
        async>
      </script>
    </section>
    {% else %}
    {% if article.url %}
    <section class="comments" id="comments">
      <h2>Comments</h2>
      <p class="comments-fallback"><a href="{{ article.url }}" target="_blank" rel="noopener noreferrer">Join the discussion on GitHub ↗</a></p>
    </section>
    {% endif %}
    {% endif %}
  </main>
<!--
  <footer class="swiss-footer">
    <div class="copyright">{{ profile.name }} &copy; {{ year_range }}</div>
    <nav class="social-links">
      {% for link in profile.socials %}
      <a href="{{ link.url }}">{{ link.name }}</a>
      {% endfor %}
    </nav>
  </footer>
-->
  <script src="/sanko.js?v=4"></script>
</body>
</html>
