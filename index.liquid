<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" id="metaThemeColor" content="#FAFAFA">
  <title>{{ profile.name }}</title>
  <meta name="description" content="{{ profile.tagline }}">
  <meta name="author" content="{{ profile.name }}">
  <meta name="generator" content="Monolog">

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <!-- Canonical -->
  <link rel="canonical" href="{{ profile.url }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ profile.name }}">
  <meta property="og:description" content="{{ profile.tagline }}">
  <meta property="og:url" content="{{ profile.url }}">
  <meta property="og:site_name" content="{{ profile.name }}">
  {% if profile.og_image %}<meta property="og:image" content="{{ profile.og_image }}">{% endif %}

 <!-- Anti-FOUC Script -->
  <script>
    (function() {
      var saved = localStorage.getItem('swiss-color');
      var paramColor = new URLSearchParams(window.location.search).get('color') || '';
      if (paramColor) {
        var hex = paramColor.replace(/^#/, '');
        if (/^[0-9a-fA-F]{3}$/.test(hex)) {
          hex = hex.charAt(0) + hex.charAt(0) + hex.charAt(1) + hex.charAt(1) + hex.charAt(2) + hex.charAt(2);
        }
        if (/^[0-9a-fA-F]{6}$/.test(hex)) {
          saved = '#' + hex.toLowerCase();
          try { localStorage.setItem('swiss-color', saved); } catch (e) {}
        }
      }
      var f = localStorage.getItem('swiss-font');
      var paramFont = new URLSearchParams(window.location.search).get('font') || '';
      if (paramFont) {
        var fontName = paramFont.trim().replace(/['"]/g, '');
        var serifFonts = ['IBM Plex Serif','Playfair Display','Fraunces','Cardo','Cormorant Garamond','EB Garamond','Spectral','Source Serif 4','Literata','Newsreader','Hepta Slab','Domine','Zilla Slab','DM Serif Display'];
        var fontGeneric = serifFonts.indexOf(fontName) !== -1 ? 'serif' : (fontName === 'IBM Plex Mono' ? 'monospace' : 'sans-serif');
        f = (fontName.indexOf(' ') !== -1 ? "'" + fontName + "'" : fontName) + ', ' + fontGeneric;
        try { localStorage.setItem('swiss-font', f); } catch (e) {}
      }
      var doc = document.documentElement;
      var m = document.getElementById('metaThemeColor');
      if (saved) {
        doc.style.setProperty('--primary', saved);
        doc.style.backgroundColor = saved;
        if (m) m.setAttribute('content', saved);
      } else {
        var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (m) m.setAttribute('content', dark ? '#111111' : '#FAFAFA');
      }
      if (f) {
        doc.style.setProperty('--font', f);
        var fontName = f.split(',')[0].replace(/['"]/g, '').trim();
        var l = document.createElement('link');
        l.rel = 'stylesheet';
        l.href = 'https://fonts.googleapis.com/css2?family=' + fontName.replace(/ /g,'+') + ':wght@400;700;900&display=swap';
        document.head.appendChild(l);
      }
    })();
  </script>

  <!-- The Look -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=IBM+Plex+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&family=Playfair+Display:wght@400;700&family=DM+Sans:wght@400;700&family=Fraunces:opsz,wght@9..144,400;9..144,700&family=Outfit:wght@400;700&family=Anton&family=Bebas+Neue&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="sanko.css?v=5">
  <script src="sanko.js?v=2" defer></script>

  <!-- Feeds -->
  {% for feed in feeds %}<link rel="alternate" type="{{ feed.mime }}" title="{{ feed.title }}" href="{{ feed.file }}" />
  {% endfor %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=IBM+Plex+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&family=Playfair+Display:wght@400;700&family=DM+Sans:wght@400;700&family=Fraunces:opsz,wght,9..144,400;9..144,700&family=Outfit:wght@400;700&family=Anton&family=Bebas+Neue&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="sanko.css?v=5">

  <!-- Per-repo filter rules (generated for repos that have articles) -->
  <style>
  {% for repo in article_repo_tags %}
  .filter-wrap:has(#tag-{{ repo }}:checked) .article-row[data-tags~="{{ repo }}"] { height: auto; opacity: 1; visibility: visible; pointer-events: auto; }
  .filter-wrap:has(#tag-{{ repo }}:checked) .proj-row[data-tags~="{{ repo }}"] { height: auto; opacity: 1; visibility: visible; pointer-events: auto; }
  .filter-wrap:has(#tag-{{ repo }}:checked) .year-group:has(.article-row[data-tags~="{{ repo }}"]) { height: auto; opacity: 1; visibility: visible; pointer-events: auto; margin-bottom: 4rem; }
  .filter-wrap:has(#tag-{{ repo }}:checked) .repo-filter[data-tag="tag-{{ repo }}"] { background: color-mix(in oklch, var(--primary) 10%, contrast-color(var(--primary))); color: var(--primary); text-decoration: none; font-weight: 700; }
  {% endfor %}
  </style>

  {% if analytics.plausible.enabled %}<!-- Plausible analytics -->
  <script defer data-domain="{{ analytics.plausible.domain }}" src="{{ analytics.plausible.src }}"></script>
  {% endif %}
  {% if analytics.cloudflare.enabled %}<!-- Cloudflare analytics -->
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "{{ analytics.cloudflare.token }}"}'></script>
  {% endif %}

  <!-- -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": "{{ profile.name }}",
      "url": "{{ profile.url }}"
    }
  }
  </script>

  <!-- ANTI-FOUC SCRIPT: Applies theme before the browser paints the first frame -->
  <script>
    (function() {
      // If the visitor picked a color, apply it before first paint
      var saved = localStorage.getItem('swiss-color');
      var paramColor = new URLSearchParams(window.location.search).get('color') || '';
      if (paramColor) {
        var hex = paramColor.replace(/^#/, '');
        if (/^[0-9a-fA-F]{3}$/.test(hex)) {
          hex = hex.charAt(0) + hex.charAt(0) + hex.charAt(1) + hex.charAt(1) + hex.charAt(2) + hex.charAt(2);
        }
        if (/^[0-9a-fA-F]{6}$/.test(hex)) {
          saved = '#' + hex.toLowerCase();
          try { localStorage.setItem('swiss-color', saved); } catch (e) {}
        }
      }
      var doc = document.documentElement;
      var m = document.getElementById('metaThemeColor');

      if (saved) {
        doc.style.setProperty('--primary', saved);

        // FORCE the HTML canvas to paint instantly, killing the View Transition white flash
        doc.style.backgroundColor = saved;
        if (m) m.setAttribute('content', saved);
      } else {
        // No saved accent: let CSS --primary track the browser light/dark
        // scheme; reflect the effective color on the chrome meta tag.
        var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (m) m.setAttribute('content', dark ? '#111111' : '#FAFAFA');
      }

      // Fetch and inject fonts
      var f = localStorage.getItem('swiss-font');
      var paramFont = new URLSearchParams(window.location.search).get('font') || '';
      if (paramFont) {
        var fontName = paramFont.trim().replace(/['"]/g, '');
        var serifFonts = ['IBM Plex Serif','Playfair Display','Fraunces','Cardo','Cormorant Garamond','EB Garamond','Spectral','Source Serif 4','Literata','Newsreader','Hepta Slab','Domine','Zilla Slab','DM Serif Display'];
        var fontGeneric = serifFonts.indexOf(fontName) !== -1 ? 'serif' : (fontName === 'IBM Plex Mono' ? 'monospace' : 'sans-serif');
        f = (fontName.indexOf(' ') !== -1 ? "'" + fontName + "'" : fontName) + ', ' + fontGeneric;
        try { localStorage.setItem('swiss-font', f); } catch (e) {}
      }
      if (f) {
        doc.style.setProperty('--font', f);
        var fontName = f.split(',')[0].replace(/['"]/g, '').trim();
        var l = document.createElement('link');
        l.rel = 'stylesheet';
        l.href = 'https://fonts.googleapis.com/css2?family=' + fontName.replace(/ /g,'+') + ':wght@400;700;900&display=swap';
        document.head.appendChild(l);
      }
    })();
  </script>
</head>
<body class="swiss-page">

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <form class="filter-wrap" id="mainForm">
    <!-- HIDDEN CHECKBOXES -->
    <input type="checkbox" id="tag-compilers" class="filter-cb" value="compilers">
    <input type="checkbox" id="tag-runtimes" class="filter-cb" value="runtimes">
    <input type="checkbox" id="tag-network" class="filter-cb" value="network">
    <input type="checkbox" id="tag-parsers" class="filter-cb" value="parsers">
    <input type="checkbox" id="tag-codegen" class="filter-cb" value="codegen">
    <input type="checkbox" id="tag-jit" class="filter-cb" value="jit">
    {% for repo in article_repo_tags %}
    <input type="checkbox" id="tag-{{ repo }}" class="filter-cb" value="{{ repo }}">
    {% endfor %}

    <!-- VIEW TOGGLES -->
    <input type="radio" name="view" id="view-projects" value="projects" class="view-cb" checked>
    <input type="radio" name="view" id="view-articles" value="articles" class="view-cb">

    <nav class="swiss-nav">
      <a href="/" class="nav-mark" aria-label="Home">SR</a>
      <div class="nav-actions">
        <button type="button" class="nav-settings" id="settingsToggle" aria-expanded="false" aria-controls="settingsPanel" aria-label="Toggle display settings"  title="Change the theme and font">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </button>
        <button type="button" class="nav-settings" id="shareLinkBtn" aria-label="Copy a link to this page with the current color, font, and filters. Tap to copy, press and hold for options." title="Tap to copy a link to this page; press and hold for options">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </button>
      </div>
    </nav>

    <div class="settings-panel" id="settingsPanel" hidden>
      <div class="settings-group">
        <label class="settings-label" for="fontSelect">Typeface</label>
        <select class="settings-select" id="fontSelect"></select>
      </div>
      <div class="settings-group">
        <label class="settings-label">Accent Color</label>
        <div class="color-presets" aria-label="Color presets">
          <button type="button" class="preset-btn" data-color="#DA291C" style="--swatch: #DA291C" aria-label="Swiss Red"></button>
          <button type="button" class="preset-btn" data-color="#D4FF00" style="--swatch: #D4FF00" aria-label="Chartreuse"></button>
          <button type="button" class="preset-btn" data-color="#FF1493" style="--swatch: #FF1493" aria-label="Deep Pink"></button>
          <button type="button" class="preset-btn" data-color="#0055FF" style="--swatch: #0055FF" aria-label="Cobalt Blue"></button>
          <button type="button" class="preset-btn" data-color="#FF5E00" style="--swatch: #FF5E00" aria-label="Safety Orange"></button>
          <button type="button" class="preset-btn" data-color="#8A2BE2" style="--swatch: #8A2BE2" aria-label="Electric Purple"></button>
          <button type="button" class="preset-btn" data-color="#00E5FF" style="--swatch: #00E5FF" aria-label="Cyan"></button>
          <button type="button" class="preset-btn" data-color="#111111" style="--swatch: #111111" aria-label="Pitch Black"></button>
          <div class="color-presets-muted">
            <button type="button" class="preset-btn" data-color="#6a5c5c" style="--swatch: #6a5c5c" aria-label="Muted Taupe"></button>
            <button type="button" class="preset-btn" data-color="#5c646c" style="--swatch: #5c646c" aria-label="Muted Slate"></button>
            <button type="button" class="preset-btn" data-color="#5d6b5c" style="--swatch: #5d6b5c" aria-label="Muted Sage"></button>
            <button type="button" class="preset-btn" data-color="#6d5c6c" style="--swatch: #6d5c6c" aria-label="Muted Mauve"></button>
            <button type="button" class="preset-btn" data-color="#7a6a5c" style="--swatch: #7a6a5c" aria-label="Muted Tan"></button>
            <button type="button" class="preset-btn" data-color="#5c5c66" style="--swatch: #5c5c66" aria-label="Muted Graphite"></button>
          </div>
        </div>
        <div class="color-row">
          <label for="colorPicker" class="sr-only" style="display:none;">Custom color picker</label>
          <input type="color" class="settings-color" id="colorPicker" value="#fafafa">
          <span class="color-hex" id="colorHex" aria-hidden="true">#FAFAFA</span>
        </div>
      </div>
      <div class="settings-group settings-close-row">
        <small class="settings-hint">Click <kbd>ESC</kbd> or tap outside to close</small>
      </div>
    </div>

    <div class="share-panel" id="sharePanel" hidden>
      <span class="share-title">Share this page</span>
      <label class="share-opt"><input type="checkbox" id="shareColor" checked> Include current color</label>
      <label class="share-opt"><input type="checkbox" id="shareFont" checked> Include current font</label>
      <label class="share-opt"><input type="checkbox" id="shareScroll"> Include scroll position</label>
      <label class="share-opt" id="shareFiltersRow"><input type="checkbox" id="shareFilters" checked> Include filters &amp; view</label>
      <input type="text" class="share-url" id="shareUrl" readonly aria-label="Shareable link">
      <button type="button" class="share-copy" id="shareCopyBtn">Copy link</button>
    </div>

    <main id="main-content">
      <section class="swiss-hero">
        <h1 class="hero-name">Sanko<br>Robinson</h1>
        <p class="hero-bio">
          I design and implement <label for="tag-compilers" class="filter-label" tabindex="0">compilers</label>, <label for="tag-runtimes" class="filter-label" tabindex="0">runtimes</label>, and the infrastructure that powers them. I also maintain several <label for="tag-network" class="filter-label" tabindex="0">network protocols</label> and systems utilities.
        </p>
        <p class="hero-bio">
          My work spans the full stack: from lexers and <label for="tag-parsers" class="filter-label" tabindex="0">parsers</label> in the frontend, through intermediate representations, to register allocation and <label for="tag-codegen" class="filter-label" tabindex="0">code generation</label>.
        </p>
        <p class="hero-bio">
          Currently focused on <label for="tag-jit" class="filter-label" tabindex="0">trace-based JIT compilation</label> and verified code generation.
        </p>

        <div class="view-toggles">
          <div class="view-tabs">
            <label for="view-projects" class="view-label" tabindex="0">Projects</label>
            <label for="view-articles" class="view-label" tabindex="0">Writing</label>
          </div>
          <button id="clearFiltersBtn" class="clear-btn" aria-label="Clear all active filters">Clear filters ✕</button>
        </div>
      </section>

      <!-- VIEW 1: PROJECTS -->
      <div class="proj-list">

              {% for project in projects %}
        <div class="proj-row" data-tags="{{ project.tags | join: ' ' }}{% if project.repoTag %} {{ project.repoTag }}{% endif %}">
          <a href="{{ project.url }}" class="proj-link-wrap" aria-label="Project: {{ project.name }}">
            <div class="proj-stack">
              <span class="proj-name">{{ project.name }}</span>
              <span class="proj-desc">{{ project.blurb | markdownInline }}</span>
            </div>
          </a>
          {% if project.articles.size > 0 %}
          <div class="proj-articles">
            <div class="proj-articles-list">
              {% for article in project.articles %}
              <article class="proj-article">
                <span class="entry-meta">{{ article.date | date: "%Y·%m·%d" }}</span>
                <div class="entry-body">
                  <h3><a href="/articles/{{ article.slug }}/">{{ article.title }}</a></h3>
                  <!--<p>{{ article.excerpt }}</p>-->
                </div>
              </article>
              {% endfor %}
              {% if project.repoTag %}
              <a class="proj-articles-more" href="/?tags={{ project.repoTag }}&amp;view=articles" data-tag="tag-{{ project.repoTag }}">More articles…</a>
              {% endif %}
            </div>
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>

      <!-- VIEW 2: ARTICLES ARCHIVE -->
      <div class="archive-wrap">
      {% for year_group in article_timeline %}
        <div class="year-group">
          <h2 class="year-label">{{ year_group.year }}</h2>
          {% for article in year_group.articles %}
          <article class="article-row" data-tags="{{ article.tags | join: ' ' }}{% if article.repo %} {{ article.repo | slugify }}{% endif %}">
            <div class="article-link-wrap">
            {% assign num = article.date | date: "%d" %}
            {% assign last_digits = num | modulo: 100 %}

            {%- if last_digits == 11 or last_digits == 12 or last_digits == 13 -%}
              {%- assign suffix = 'th' -%}
            {%- else -%}
              {%- assign last_digit = num | modulo: 10 -%}
              {%- case last_digit -%}
                {%- when 1 -%}{%- assign suffix = 'st' -%}
                {%- when 2 -%}{%- assign suffix = 'nd' -%}
                {%- when 3 -%}{%- assign suffix = 'rd' -%}
                {%- else -%}{%- assign suffix = 'th' -%}
              {%- endcase -%}
            {%- endif -%}
              <div class="article-meta"><time datetime="{{ article.date | date: "%Y-%m-%d" }}">{{ article.date | date: "%b %d" }}{{ suffix }}</time>
                {% if article.readTime %}<span class="article-readtime">{{ article.readTime }} min read</span>{% endif %}
                {% if article.repo %}<span class="article-repo filter-label repo-filter" data-tag="tag-{{ article.repo | slugify }}">#{{ article.repoDisplay }}</span>{% endif %}</div>
              <div class="article-content">
                <h3 class="article-title"><a href="/articles/{{ article.slug }}/">{{ article.title }}</a></h3>
                <p class="article-desc">{{ article.excerpt }}</p>
              </div>
            </div>
          </article>
          {% endfor %}
        </div>
        {% endfor %}
       </div>
    </main>
  </form>

</body>
</html>
